# 🛡️ QUALITY GATE: Verify types before committing
# Why: This ensures that a change in one file hasn't broken another part of the project.
# It prevents "broken" code from being saved to Git.
npm run type-check

# 🧪 TEST RUNNER: Verify logic correctness
# Why: This ensures all unit tests pass before code is committed.
# It prevents regressions from entering the codebase.
#npm test

# 🧹 AUTO-FORMAT & LINT: Clean up the code
npx lint-staged

# 🛡️ SECRET SCANNER: Basic check for obvious secrets
if git diff --cached -- ':!.husky' | grep -iE "AKIA[0-9A-Z]{16}|sk_live_[0-9a-zA-Z]{24}|BEGIN RSA PRIVATE KEY"; then
  {
    echo "🚫 ERROR: Potential secret leaked in staging area!"
    echo "Commit blocked to protect your keys."
  } | tee -a husky-errors.log
  exit 1
fi

# 🌿 BRANCH NAME ENFORCER: Block bad branch names
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)
VALID_BRANCH_REGEX="^(main|master|feature\/|bugfix\/|hotfix\/|release\/|chore\/)"

if [[ ! $BRANCH_NAME =~ $VALID_BRANCH_REGEX ]]; then
  {
    echo "🚫 ERROR: Branch '$BRANCH_NAME' does not follow conventions."
    echo "Must start with feature/, bugfix/, hotfix/, release/, or chore/"
  } | tee -a husky-errors.log
  exit 1
fi
