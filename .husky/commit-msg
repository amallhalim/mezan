if ! npx --no -- commitlint --edit "${1}"; then
  {
    echo ""
    echo "🚫 ================================================================= 🚫"
    echo "    ERROR: Invalid Commit Message Format"
    echo "    Your commit was blocked because it doesn't follow the rules."
    echo "    You MUST start your message with a type (feat:, fix:, chore:, etc)"
    echo ""
    echo "    ✅ CORRECT: git commit -m \"feat: added new login button\""
    echo "    ❌ WRONG:   git commit -m \"added new login button\""
    echo "🚫 ================================================================= 🚫"
    echo ""
  } | tee -a husky-errors.log
  exit 1
fi
